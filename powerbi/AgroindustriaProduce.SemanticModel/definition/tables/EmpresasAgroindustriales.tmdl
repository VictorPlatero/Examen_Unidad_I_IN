table EmpresasAgroindustriales
    lineageTag: empresas-agroindustriales-produce

    column id_anonimo_emp
        dataType: string
        sourceColumn: id_anonimo_emp

    column anio
        dataType: int64
        sourceColumn: anio

    column ciiu
        dataType: string
        sourceColumn: ciiu

    column descripcion_ciiu
        dataType: string
        sourceColumn: descripcion_ciiu

    column sector
        dataType: string
        sourceColumn: sector

    column ubigeo
        dataType: string
        sourceColumn: ubigeo

    column departamento
        dataType: string
        sourceColumn: departamento

    column provincia
        dataType: string
        sourceColumn: provincia

    column distrito
        dataType: string
        sourceColumn: distrito

    column tamanio_emp
        dataType: string
        sourceColumn: tamanio_emp

    column valor_estimado_minimo_venta
        dataType: decimal
        sourceColumn: valor_estimado_minimo_venta

    column valor_estimado_maximo_venta
        dataType: decimal
        sourceColumn: valor_estimado_maximo_venta

    column exporta
        dataType: boolean
        sourceColumn: exporta

    column valor_estimado_minimo_fob_dolar
        dataType: decimal
        sourceColumn: valor_estimado_minimo_fob_dolar

    column valor_estimado_maximo_fob_dolar
        dataType: decimal
        sourceColumn: valor_estimado_maximo_fob_dolar

    column fec_creacion
        dataType: dateTime
        sourceColumn: fec_creacion

    partition EmpresasAgroindustriales = m
        mode: import
        source =
            let
                Source = PostgreSQL.Database(Parameter_Server, Parameter_Database),
                View = Source{[Schema="agroindustria",Item="vw_empresas_agroindustriales"]}[Data]
            in
                View
